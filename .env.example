# Get a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Upstash Redis (free tier) — session metadata storage.
# Provision via: vercel integration add upstash/upstash-kv
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Vercel Blob (free tier) — page image storage.
# Provision via: vercel blob create-store <name> --access private
BLOB_READ_WRITE_TOKEN=
